<Window x:Class="cinestream_webview2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="CineStream - Watson's Tech Services" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#07050f">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Overlay container for streaming services (placed BEFORE MainWebView so it's behind it in Z-order) -->
        <Grid x:Name="ServiceGrid" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#07050f" />

        <!-- Main CineStream Hub UI (placed AFTER ServiceGrid so it overlays it when visible) -->
        <wv2:WebView2 x:Name="MainWebView" Grid.Column="0" Grid.ColumnSpan="2" MouseLeave="MainWebView_MouseLeave" />

        <!-- Transparent edge trigger for revealing the sidebar when collapsed (only active when service is running) -->
        <Border x:Name="LeftEdgeTrigger" Grid.Column="0" Width="10" HorizontalAlignment="Left" Background="Transparent" Visibility="Collapsed" MouseEnter="LeftEdgeTrigger_MouseEnter" />
    </Grid>
</Window>
